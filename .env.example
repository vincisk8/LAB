# Proveedor de LLM. Sin ANTHROPIC_API_KEY la app arranca en modo "simulado" (sin LLM, sin costo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_MODE=anthropic|simulado   (por defecto: anthropic si hay API key)

# Fecha contra la que se calculan las vigencias. Fíjala para que la defensa sea reproducible.
FECHA_REFERENCIA=2026-11-19

# Protección de la URL pública (recomendado): la UI pide este código.
ACCESS_CODE=
RATE_LIMIT_PER_MIN=20

PORT=3000
MAX_ITERACIONES=14
MAX_TOKENS_SALIDA=2048
